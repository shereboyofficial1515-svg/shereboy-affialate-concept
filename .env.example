# ---------------------------------------------
# SHEREBOY AFFILIATE CONCEPT — environment config
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to git.
# ---------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Supabase — from your project's Dashboard → Project Settings → API
SUPABASE_URL=replace_this_with_another_long_random_string
SUPABASE_ANON_KEY=replace_this_with_another_long_random_string
# Service role key: server-side ONLY. Bypasses Row Level Security.
# Never expose this in frontend code or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=replace_this_with_another_long_random_string

# Cookie signing (used by cookie-parser for signed cookies)
COOKIE_SECRET=replace_this_with_another_long_random_string

# Admin bootstrap account (created in Supabase Auth the first time you run "npm run seed")
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=put-your-password

# Google Gemini AI (used by the floating shopping assistant)
GEMINI_API_KEY=replace_this_with_another_long_random_string
GEMINI_MODEL=replace_this_with_another_long_random_string

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# Product images are stored in this PUBLIC Supabase Storage bucket (created automatically)
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# Public partner feed (/api/public) — used by the SHEREBOY TECH LTD website
PUBLIC_SITE_URL=https://shereboyaffiliateconcept.shop
PUBLIC_API_ALLOWED_ORIGINS=https://shereboytechltd.site,https://www.shereboytechltd.site
# Optional: tell the company website immediately when products change.
# The secret must equal AFFILIATE_WEBHOOK_SECRET on the company website.
COMPANY_SITE_WEBHOOK_URL=https://shereboytechltd.site/api/affiliate-feed/webhook
COMPANY_SITE_WEBHOOK_SECRET=replace_this_with_another_long_random_string
